-- astro --
calculate astrology charts in the linux terminal

--o-KEYBINDS---o-

NORMAL MODE - esc

-navigation		-	hjkl
-draw chart 	- 	enter
-autofill systime-	tab

-save chart 	-	w
	-choose dir 	-	q
	-mkdir			-	m
	-cancel save	-	esc
-load chart		-	e
	-choose file	-	l / enter
	-cancel			-	q

INSERT MODE - i (on by default)

-navigation 	-	arrowkeys

CHART VIEW

-exit program	-	q
-new chart		-	i

DATA

charts are saved in $XDG_DATA_HOME

