-- astroterm --

---vim bindings
--hit esc to enter NORMAL mode

--j == up
--k == down

--esc again to fill data with local-time. 

--hit i to enter INSERT mode (on by default)

--up arrow == up
--down arrow == down

--F1 to close data entry and open chart
--i when in chartview to input new data
--q to quit the program

