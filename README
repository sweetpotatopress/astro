--o https://sweetpotato.press --o
DEPENDENCIES

ncurses

KEYBINDS

enter		animate chart  
	h/l 	time increment  
	k/j 	up/down  

s			solar return  
	k/j		up/down year  
	s/q/esc	exit mode  

p			toggle left table
o 			toggle right table
0...9		select chart number

tab			live update  
d			toggle dst
r			redraw chart  
q			exit astro  

w			save chart  
	m		makedir  
	esc		cancel  
	esc/q	choose dir
	enter	save named chart
	
e		 	load chart  
	l/enter	choose  
	esc		cancel  
 
i			input chart data  

INPUT CHART DATA

i			INSERT mode  

	F1		clear fields  
	tab		fill local time  
	arrows	navigate  
	\		draw chart

esc			NORMAL mode  

	enter	draw chart 
	w		save chart  
	e		load chart  
	
	k/j		up/down  
	h/l		left/right  
	q		exit data input  

DATA DIRECTORIES

astro				: /usr/local/bin  

city-db 			: $XDG_DATA_HOME/astro
swisseph/ephe/ 		: $XDG_DATA_HOME/astro
charts/ 			: $XDG_DATA_HOME/astro
 
OPTIONAL
to set default IANA timezone and location

config				: $XDG_CONFIG_HOME/astro  

config template : 
 
timezone = America/Chicago
latitude = 41.85003
longitude = -87.65005
 
